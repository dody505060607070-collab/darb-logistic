# Runtime environment for the Darb app and PetroApp bridge.
# Copy to /opt/darb/config/.env.darb and fill from protected provider credentials.
# Never commit the populated file or print it in logs.
SUPABASE_URL=http://api-gw:8000
# Public key and service key are generated by prepare-supabase.sh from the local Supabase .env.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=
LOVABLE_CRON_SECRET=
WHATSAPP_SERVER_URL=http://evolution-api:8080
WHATSAPP_INSTANCE=
WHATSAPP_SERVER_KEY=
PETROAPP_RAE_BRIDGE_URL=http://petroapp-bridge:8080
PETROAPP_RAE_BRIDGE_TOKEN=
PETROAPP_BEARER_TOKEN=
PETROAPP_FINGERPRINT=
PETROAPP_PAYMENT_STATUS_MAP={}
DAMAN_GPS_API_KEY=
DAMAN_GPS_FLEET_ID=
ORS_API_KEY=
TRACCAR_URL=
TRACCAR_EMAIL=
TRACCAR_PASSWORD=
AI_API_KEY=
AI_API_BASE_URL=
AI_MODEL=
