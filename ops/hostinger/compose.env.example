# Non-secret Docker Compose interpolation values.
# Choose ports only after a read-only VPS port inventory. Do not assume defaults are free.
DARB_REPO_ROOT=/opt/darb
DARB_CONFIG_DIR=/opt/darb/config
DARB_APP_BIND_PORT=
DARB_SUPABASE_HTTP_BIND_PORT=
DARB_SUPABASE_DB_BIND_PORT=
DARB_SUPABASE_POOLER_BIND_PORT=
DARB_SUPABASE_DIR=/opt/darb/supabase
DARB_ENABLE_SCHEDULED_JOBS=false
DARB_ENABLE_WHATSAPP_SENDING=false
DARB_APP_IMAGE=
DARB_PETROAPP_BRIDGE_IMAGE=
DARB_MIGRATION_IMAGE=
DARB_AUTO_MIGRATE=false
DARB_DATA_IMPORT_COMPLETE=false
# Verified live gateway version: Evolution API 2.3.7. Confirm the source image/digest before copying session state.
EVOLUTION_API_IMAGE=evoapicloud/evolution-api:v2.3.7
