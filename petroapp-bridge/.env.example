# Darb -> bridge authentication. Generate a long random value; never commit it.
PETROAPP_RAE_BRIDGE_TOKEN=
# Source session material, stored only on the bridge host.
PETROAPP_BEARER_TOKEN=
PETROAPP_FINGERPRINT=
# Exact case-sensitive observed values only. {} deliberately leaves every state unmapped.
# Example shape only; replace keys solely with values established by a permitted capture:
# PETROAPP_PAYMENT_STATUS_MAP={"OBSERVED_COMPLETED_VALUE":"completed","OBSERVED_CANCELLED_VALUE":"cancelled"}
PETROAPP_PAYMENT_STATUS_MAP={}
